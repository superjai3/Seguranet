@using Seguranet.Models
@model Seguranet.Models.ContactoViewModel

@{
    ViewBag.Title = "Contacto";
    ViewBag.Descripcion = "Escribinos o llamanos: datos de contacto, horarios de atención y formulario de consulta de Seguranet.";
}

@* Esta página empezaba con el iframe del formulario, declarado con
   height:1800px. Cuando forms.app no carga —lo bloquea un adblocker, la red de
   una oficina, o sencillamente tarda— lo primero que ve el visitante son mil
   ochocientos píxeles de nada, y la información de contacto queda tan abajo
   que parece que la página está rota. Tal cual pasó en la demo publicada.

   Ahora el orden es al revés: primero el correo, el WhatsApp y los horarios,
   que son lo que alguien viene a buscar y no dependen de ningún tercero, y
   después el formulario, con su propio título y un enlace para abrirlo en una
   pestaña aparte si el marco queda en blanco. Así, cuando el iframe falla, se
   pierde el formulario, no la página. *@

<main>
    <!-- SECTION: Introducción -->
    <section class="intro bg-light py-5">
        <div class="container text-center">
            <h1 class="display-4 mb-3 text-success">Contacto</h1>
            <p class="lead mb-0">Escribinos por donde te quede más cómodo. Respondemos dentro del horario de atención.</p>
        </div>
    </section>

    <!-- SECTION: Información de Contacto -->
    <section class="contact-info bg-light py-5">
        <div class="container">
            <div class="row text-center">
                <!-- Información de Contacto -->
                <div class="col-md-6 mb-4">
                    <h2 class="display-6 text-success mb-4">Información de Contacto</h2>
                    <div class="lead mb-3">
                        <!-- Email -->
                        <div class="d-flex justify-content-center mb-3">
                            <strong class="mr-2">Email: </strong>
                            @*  El icono va dibujado acá adentro y no traído de un servidor
                                ajeno: antes se pedía a cdn-icons-png.flaticon.com, que además
                                de gastar ancho de banda de otro exige atribución por licencia.
                                Y el correo era @@seguranet.com.ar, un dominio que todavía no
                                está comprado: cualquiera que escribiera recibía un rebote.  *@
                            <a href="mailto:contacto@@seguranet.es" class="btn btn-outline-primary btn-lg">
                                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <rect x="2" y="4" width="20" height="16" rx="2"></rect>
                                    <path d="m2 7 10 6 10-6"></path>
                                </svg>
                                Enviar Email
                            </a>
                        </div>

                        <!-- Teléfono y Whatsapp -->
                        <div class="d-flex justify-content-center">
                            <strong class="mr-2">Teléfono:  </strong>
                            <a href="https://wa.me/34632638449" target="_blank" rel="noopener" class="btn btn-outline-success btn-lg">
                                @*  Globo de chat genérico en vez del logo de WhatsApp: el logo
                                    es marca registrada de Meta y usarlo necesita permiso. Nombrar
                                    el servicio en el texto del botón sí se puede.  *@
                                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M21 11.5a8.4 8.4 0 0 1-9 8.4 8.5 8.5 0 0 1-3.9-.9L3 20.5l1.5-4.4A8.4 8.4 0 0 1 12 3.1a8.4 8.4 0 0 1 9 8.4z"></path>
                                </svg>
                                Enviar WhatsApp
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Horario de Atención -->
                <div class="col-md-6">
                    <h2 class="display-6 text-success mb-4">Horario de Atención</h2>
                    <div class="lead">
                        <p><strong>Lunes a Viernes:</strong> 9:00 AM - 6:00 PM</p>
                        <p><strong>Sábados:</strong> 9:00 AM - 2:00 PM</p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- SECTION: Formulario de consulta -->
    <section class="py-5">
        <div class="container">
            <h2 class="display-6 text-success mb-3 text-center">Formulario de consulta</h2>
            <p class="text-center mb-4">
                Contanos qué necesitás y te respondemos por correo.
                ¿El formulario queda en blanco?
                <a href="https://2u2yqkbs.forms.app/form/674203e6abf58c3603bcd878" target="_blank" rel="noopener">
                    Abrilo en una pestaña nueva
                </a>.
            </p>
            @*  La Ley 25.326 (art. 6) pide avisar ANTES de recoger un dato personal
                para qué se usa, quién lo trata y cómo se lo borra. El formulario no
                vive en este servidor sino en forms.app, así que además hay que
                decirlo: el visitante tiene derecho a saber a dónde va lo que
                escribe. Antes no se avisaba nada.  *@
            <p class="small text-muted text-center mb-4">
                Lo que escribas se usa sólo para responderte tu consulta y no se cede
                a terceros con fines comerciales. El formulario lo presta
                <strong>forms.app</strong>, un servicio externo que aloja las respuestas.
                Podés pedir ver, corregir o borrar tus datos escribiendo a
                <a href="mailto:contacto@@seguranet.es">contacto@@seguranet.es</a>.
                La Agencia de Acceso a la Información Pública es el organismo de control
                y atiende reclamos sobre protección de datos personales.
            </p>
            <iframe title="Formulario de contacto de Seguranet"
                    loading="lazy"
                    src="https://2u2yqkbs.forms.app/form/674203e6abf58c3603bcd878"
                    style="width: 100%; min-width: 100%; height: 1200px; border: none;"></iframe>
        </div>
    </section>
</main>
