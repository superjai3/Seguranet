@{
    // Cada vista pone su propio título y su propia descripción. Los valores de
    // acá abajo son el paracaídas por si alguna se olvida, no el texto de todas:
    // una descripción repetida en trece páginas es una descripción que Google
    // ignora.
    var tituloPagina = (string)(ViewBag.Title ?? "Seguranet");
    var descripcionPagina = (string)(ViewBag.Descripcion
        ?? "Seguranet: cotizá y gestioná seguros de auto en línea. Coberturas, siniestros y atención al cliente en un solo lugar.");

    // Esta misma página sin la cadena de consulta: es lo que declara la
    // canónica y lo que se comparte en redes.
    var urlCanonica = Request.Url == null ? "" : Request.Url.GetLeftPart(UriPartial.Path);
    var raizDelSitio = Request.Url == null ? "" : Request.Url.GetLeftPart(UriPartial.Authority);
    var urlImagenSocial = Request.Url == null
        ? ""
        : new Uri(Request.Url, Url.Content("~/Imagenes/hero-image.png.webp")).AbsoluteUri;
    var urlLogo = Request.Url == null
        ? ""
        : new Uri(Request.Url, Url.Content("~/Imagenes/Logo Seguranet.webp")).AbsoluteUri;
}
<!DOCTYPE html>
<html lang="es">

<head>
    <title>@tituloPagina · Seguranet</title>

    <!-- Primary metatags -->
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />

    <!--SEO-->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@descripcionPagina" />
    <meta name="author" content="Seguranet" />
    @* Todas las páginas que pasan por este layout son públicas y se indexan.
       Las de cuenta (Views/Inicio) no lo usan: tienen Layout = null y su propio
       <head>, y ahí va su noindex. *@
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <link rel="canonical" href="@urlCanonica" />

    <!--Redes: sin esto, el enlace compartido sale gris y sin imagen-->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Seguranet" />
    <meta property="og:title" content="@tituloPagina" />
    <meta property="og:description" content="@descripcionPagina" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:url" content="@urlCanonica" />
    <meta property="og:image" content="@urlImagenSocial" />
    <meta property="og:image:alt" content="Seguranet, cotizador de seguros de auto en línea" />
    <meta name="twitter:card" content="summary_large_image" />

    <!--FAVICON-->
    <link rel="icon" type="image/x-icon" href="~/favicon.ico">

    @* Las hojas de estilo vienen de cuatro dominios distintos. Avisarle al
       navegador a dónde va a tener que ir le ahorra resolver el DNS y negociar
       el TLS recién cuando ya es tarde. *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="preconnect" href="https://use.fontawesome.com" crossorigin>

    <!-- ICONOS-->
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css"
          integrity="sha384-DyZ88mC6Up2uqS4h/KRgHuoeGwBcD4Ng9SiP4dIRy0EXTlnuz47vAwmeGwVChigm" crossorigin="anonymous" />

    <!--GOOGLE FONTS-->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,500;0,700;0,800;0,900;1,600&display=swap"
          rel="stylesheet" />

    <!--ANIMATE CSS-->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    @* Bootstrap 5.3.3, la misma versión que trae el paquete de NuGet en
       Content/bootstrap.css. Acá decía 5.2.0-beta1: además de ser una versión de
       prueba en producción, no coincidía con la local, así que una página se veía
       con una versión u otra según pasara o no por este layout. El hash SRI está
       calculado del archivo que sirve el CDN, no copiado de ningún lado. *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

    <!-- CUSTOM CSS -->
    <link rel="stylesheet" type="text/css" href="~/Style/styles.css">

    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    @* Qué es este sitio, en el vocabulario de schema.org. Sin esto, en los
       resultados de búsqueda es una página más sin identidad. *@
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "WebSite",
          "name": "Seguranet",
          "url": "@raizDelSitio",
          "inLanguage": "es-AR",
          "description": "Cotizador y gestor de seguros de auto en línea.",
          "publisher": {
            "@@type": "Organization",
            "name": "Seguranet",
            "logo": {
              "@@type": "ImageObject",
              "url": "@urlLogo"
            }
          }
        }
    </script>
</head>

<body>
    <div class="container body-content">

        <!--HEADER-->

            <header>
                <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-secondary">
                    <div class="container">
                        @* El logo lleva alt vacío y el enlace lleva aria-label: el
                           nombre del sitio ya lo dice el enlace, y con
                           alt="Logo Seguranet" un lector de pantalla leía la marca
                           dos veces seguidas. *@
                        <a href="@Url.Action("Index", "Home")" aria-label="Seguranet, inicio">
                            <img src="~/Imagenes/Logo Seguranet.webp" alt="" class="logo-navbar">
                        </a>

                        <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Alternar navegación" aria-controls="navbarSupportedContent"
                                aria-expanded="false" aria-label="Toggle navigation">
                            <span class="navbar-toggler-icon"></span>
                        </button>
                        <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                            <ul class="navbar-nav flex-grow-1">
                                <li>@Html.ActionLink("Inicio", "Index", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                                <li>@Html.ActionLink("Nosotros", "Nosotros", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                                <li>@Html.ActionLink("Coberturas", "Coberturas", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                                @* Este enlace apuntaba a
                                   http://127.0.0.1:5500/CotizadorSeguros/html/index.html,
                                   la dirección de Live Server en la máquina de
                                   quien lo programó, y estaba en el menú de TODAS
                                   las páginas del sitio: para cualquier visitante
                                   no llevaba a ningún lado. *@
                                <li>@Html.ActionLink("Cotizador", "CotizadorAuto", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                                <li>@Html.ActionLink("Preguntas", "Preguntas", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                                <li>@Html.ActionLink("Socios", "Ayuda", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                                <li>@Html.ActionLink("Siniestros", "Siniestros", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                                <li>@Html.ActionLink("Contacto", "Contacto", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                            </ul>

                            @* Antes acá había un enlace fijo a
                               https://localhost:44395/ —el puerto de IIS Express
                               en desarrollo— que además no cerraba nada, porque no
                               existía ni la sesión ni la acción para cerrarla.

                               Ahora el bloque cambia según haya alguien adentro o
                               no, y el cierre va por POST con token antiforgery:
                               con un GET alcanzaría que alguien indujera al
                               navegador a pedir esa dirección para dejar afuera a
                               la persona sin que lo pidiera. *@
                            <ul class="navbar-nav ml-auto">
                                @if (Seguranet.Servicios.SesionServicio.HayUsuario(Session))
                                {
                                    <li class="nav-item">
                                        @using (Html.BeginForm("Salir", "Inicio", FormMethod.Post, new { @class = "form-inline" }))
                                        {
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="nav-link btn btn-link">Cerrar sesión</button>
                                        }
                                    </li>
                                }
                                else
                                {
                                    <li>@Html.ActionLink("Ingresar", "Login", "Inicio", new { area = "" }, new { @class = "nav-link" })</li>
                                }
                            </ul>

                        </div>
                    </div>
                </nav>
            </header>


            @RenderBody()


            <!-- COMIENZA EL FOOTER -->
            <footer class="footer">
                <div class="container body-content">
                    <div class="footer-sm">
                        <div class="footer-bottom">
                            <div class="container">
                                <div class="row footer-bottom__copyright">
                                    <div class="col">
                                        <p>&copy; Copyright @DateTime.Now.Year  |  Proyecto Final  |  Integración de Sistemas - ISTEA | SEGURANET.COM.AR </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </footer>

    </div>

    @Scripts.Render("~/bundles/jquery")
    @* El paquete ~/bundles/bootstrap sirve Scripts/bootstrap.js, el mismo
       Bootstrap que ya baja del CDN acá abajo —y encima sin Popper, que es lo que
       necesitan los menús desplegables—. Las páginas con layout lo toman del CDN
       una sola vez; el paquete queda para las de Views/Inicio, que no pasan por
       este layout y si no se quedarían sin nada. *@
    @RenderSection("scripts", required: false)

    <!--Bootstrap-->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>

    <!-- JavaScript -->
    <script src="https://kit.fontawesome.com/66003e86ce.js" crossorigin="anonymous" defer></script>

    @* Acá había trece <script> más.

       Diez apuntaban a archivos que no existen en el proyecto —src/utils.js,
       src/renderhtml.js, src/storage.js, src/validations.js, src/quoter.js,
       src/customSelect.js, src/main.js, darkMode.js y main.js—: se buscaron por
       nombre en todo el repositorio y no aparece ninguno. Eran diez 404 en cada
       carga de cada página, y con ruta relativa, con lo cual se pedían a una
       dirección distinta según la ruta desde la que se entrara.

       Los otros tres —SweetAlert2, Luxon y Toastify— sí existen, pero no los
       llama nadie: eran las bibliotecas de ese JavaScript perdido. Se buscaron
       sus puntos de entrada (Swal, DateTime.fromISO, Toastify) en todas las
       vistas y en Scripts/, y no hay una sola llamada. Tres pedidos por página
       para no usarlos.

       Si en algún momento se recupera ese JavaScript, hay que volver a agregar lo
       que haga falta, con ruta absoluta (~/Scripts/...), no relativa. *@
</body>
</html>
