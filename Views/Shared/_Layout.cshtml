@{
    // Cada vista pone su propio título y su propia descripción. Los valores de
    // acá abajo son el paracaídas por si alguna se olvida, no el texto de todas:
    // una descripción repetida en trece páginas es una descripción que Google
    // ignora.
    var tituloPagina = (string)(ViewBag.Title ?? "Seguranet");
    var descripcionPagina = (string)(ViewBag.Descripcion
        ?? "Seguranet: cotizá y gestioná seguros de auto en línea. Coberturas, siniestros y atención al cliente en un solo lugar.");

    // Esta misma página sin la cadena de consulta: es lo que declara la
    // canónica y lo que se comparte en redes.
    var urlCanonica = Request.Url == null ? "" : Request.Url.GetLeftPart(UriPartial.Path);
    var urlImagenSocial = Request.Url == null
        ? ""
        : new Uri(Request.Url, Url.Content("~/Imagenes/hero-image.png.webp")).AbsoluteUri;
    var raizDelSitio = Request.Url == null
        ? ""
        : Request.Url.GetLeftPart(UriPartial.Authority);
    var urlLogo = Request.Url == null
        ? ""
        : new Uri(Request.Url, Url.Content("~/Imagenes/Logo Seguranet.webp")).AbsoluteUri;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <title>@tituloPagina · Seguranet</title>

    <!-- Primary metatags -->
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />

    <!--SEO-->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="@descripcionPagina" />
    <meta name="author" content="Seguranet" />
    @* Todas las páginas que pasan por este layout son públicas y se indexan.
       Las de cuenta (Views/Inicio) no lo usan: tienen Layout = null y su propio
       <head>, y ahí va su noindex. *@
    <meta name="robots" content="index, follow, max-image-preview:large" />

    <link rel="canonical" href="@urlCanonica" />

    <!--Redes: sin esto, el enlace compartido sale gris y sin imagen-->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Seguranet" />
    <meta property="og:title" content="@tituloPagina" />
    <meta property="og:description" content="@descripcionPagina" />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:url" content="@urlCanonica" />
    <meta property="og:image" content="@urlImagenSocial" />
    <meta property="og:image:alt" content="Seguranet, cotizador de seguros de auto en línea" />
    <meta name="twitter:card" content="summary_large_image" />

    <!--FAVICON-->
    <link rel="icon" type="image/x-icon" href="~/favicon.ico">

    @* Las hojas de estilo vienen de cuatro dominios distintos. Avisarle al
       navegador a dónde va a tener que ir le ahorra resolver el DNS y negociar
       el TLS recién cuando ya es tarde. *@
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
    <link rel="preconnect" href="https://use.fontawesome.com" crossorigin>

    <!-- ICONOS-->
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.15.4/css/all.css"
          integrity="sha384-DyZ88mC6Up2uqS4h/KRgHuoeGwBcD4Ng9SiP4dIRy0EXTlnuz47vAwmeGwVChigm" crossorigin="anonymous" />

    <!--GOOGLE FONTS-->
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:ital,wght@0,400;0,500;0,700;0,800;0,900;1,600&display=swap"
          rel="stylesheet" />

    <!--ANIMATE CSS-->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <!--Bootstrap -->
    @* Bootstrap 5.2.0 estable. Acá decía 5.2.0-beta1: el sitio dependía en
       producción de una versión de prueba. *@
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-gH2yIJqKdNHPEq0n4Mqa/HGKIhSkIHeL5AyhkYV8i59U5AR6csBvApHHNl/vI1Bx" crossorigin="anonymous">

    <!--Toastify-->
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/toastify-js/src/toastify.min.css" />

    <!-- CUSTOM CSS -->
    <link rel="stylesheet" type="text/css" href="~/Style/styles.css">


    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    @* Qué es este sitio, en el vocabulario de schema.org. Sin esto, en los
       resultados de búsqueda es una página más sin identidad. *@
    <script type="application/ld+json">
        {
          "@@context": "https://schema.org",
          "@@type": "WebSite",
          "name": "Seguranet",
          "url": "@raizDelSitio",
          "inLanguage": "es-AR",
          "description": "Cotizador y gestor de seguros de auto en línea.",
          "publisher": {
            "@@type": "Organization",
            "name": "Seguranet",
            "logo": {
              "@@type": "ImageObject",
              "url": "@urlLogo"
            }
          }
        }
    </script>
</head>

<body>

    <!--HEADER-->
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-dark bg-secondary">
            <div class="container">
                <img src="~/Imagenes/Logo Seguranet.webp" alt="Logo Seguranet" class="logo-navbar">
                @Html.ActionLink("Seguranet", "Index", "Home", new { area = "" }, new { @class = "navbar-brand" })
                <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Alternar navegación" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li>@Html.ActionLink("Inicio", "Index", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                        <li>@Html.ActionLink("Nosotros", "Nosotros", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                        <li>@Html.ActionLink("Coberturas", "Coberturas", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                        <li>@Html.ActionLink("CotizadorAuto", "CotizadorAuto", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                        <li>@Html.ActionLink("Preguntas", "Preguntas", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                        <li>@Html.ActionLink("Socios", "Ayuda", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                        <li>@Html.ActionLink("Siniestros", "Siniestros", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                        <li>@Html.ActionLink("Contacto", "Contacto", "Home", new { area = "" }, new { @class = "nav-link" })</li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>


    <div class="container body-content">
        @RenderBody()
        <hr />

        <!--COMIENZA EL FOOTER-->
        <footer class="footer">
            <div class="footer-sm">
            </div>
            <div class="footer-bottom">
                <div class="container">
                    <div class="row footer-bottom__copyright">
                        <div class="col">
                            <p>&copy; Copyright @DateTime.Now.Year  |  Proyecto Final  |  Integración de Sistemas - ISTEA</p>
                        </div>
                    </div>
                </div>
            </div>
        </footer>



    </div>

    @Scripts.Render("~/bundles/jquery")
    @* El paquete ~/bundles/bootstrap servía Scripts/bootstrap.js, que es el
       mismo Bootstrap 5.2.0 que ya baja del CDN unas líneas más abajo —y encima
       sin Popper, que es lo que necesitan los menús desplegables—. Se carga una
       sola vez, la del CDN, que sí es el paquete completo. *@
    @RenderSection("scripts", required: false)

    <!--Bootstramp-->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.0/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-A3rJD856KowSb7dwlZdYEkO39Gagi7vIsF0jrRAoQmDKKtQBHUuLZ9AsSv4jD4Xa"
            crossorigin="anonymous"></script>

    <!--Sweet Alert-->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <!--Luxon-->
    <script src="https://cdn.jsdelivr.net/npm/luxon@2.3.0/build/global/luxon.min.js"></script>

    <!-- JavaScript -->
    <script src="https://kit.fontawesome.com/66003e86ce.js" crossorigin="anonymous" defer></script>
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/toastify-js" defer></script>

    @* Acá había diez <script> más: src/utils.js, src/renderhtml.js,
       src/storage.js, src/validations.js, src/quoter.js, src/customSelect.js,
       src/main.js, darkMode.js y main.js. Ninguno de esos archivos existe en el
       proyecto —se buscaron por nombre en todo el repositorio—, así que eran
       diez 404 en cada carga de cada página. Encima con ruta relativa, con lo
       cual se pedían a una dirección distinta según la ruta desde la que se
       entrara. Se sacan: si en algún momento se recupera ese JavaScript, hay
       que volver a agregarlos con ruta absoluta (~/Scripts/...). *@
</body>
</html>
