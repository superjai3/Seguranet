# Configuración con secretos de Seguranet.
#
# Este archivo es una PLANTILLA. La copia de verdad vive en el servidor, en
# /etc/seguranet.env, y NO está en el repositorio ni tiene por qué estarlo.
#
#   sudo cp seguranet.env.ejemplo /etc/seguranet.env
#   sudo nano /etc/seguranet.env          # completar los huecos
#   sudo chown root:root /etc/seguranet.env
#   sudo chmod 600 /etc/seguranet.env     # sólo root puede leerlo
#
# El doble guion bajo es cómo .NET traduce la jerarquía de appsettings.json:
# "Correo": { "Clave": ... }  ->  Correo__Clave
#
# Lo que se ponga acá pisa lo que diga appsettings.json, así que el repositorio
# puede quedarse con los valores vacíos y públicos sin que eso afecte a
# producción.


# --- Dominio -----------------------------------------------------------------
# Sin https:// y sin barra final. De acá salen las URL canónicas, las de Open
# Graph y el sitemap. Mientras esté vacío se usa el host del pedido, que sirve
# para probar por IP antes de que el dominio resuelva.
Sitio__Dominio=seguranet.es


# --- MercadoLibre ------------------------------------------------------------
# De donde salen los años, marcas, modelos y versiones del cotizador.
# El ClientId es público y ya está en appsettings.json; sólo hace falta el
# secreto. Está en developers.mercadolibre.com.ar -> Mis aplicaciones -> la app.
#
# El RedirectUri tiene que ser EXACTAMENTE el mismo que esté dado de alta en la
# aplicación de MercadoLibre. Si no coinciden, el intercambio de token falla sin
# decir por qué.
MercadoLibre__ClientSecret=
MercadoLibre__RedirectUri=https://seguranet.es/api/auth/callback


# --- Correo ------------------------------------------------------------------
# Confirmación de cuenta y restablecimiento de clave.
#
# OJO: la clave NO es la contraseña de la cuenta de Google. Google dejó de
# aceptarla por SMTP en 2022. Hace falta una CONTRASEÑA DE APLICACIÓN, de 16
# caracteres, que se genera en:
#
#     https://myaccount.google.com/apppasswords
#
# Se pega sin espacios. Cambiar la contraseña de la cuenta invalida todas las
# contraseñas de aplicación, así que si se cambia hay que generar una nueva.
Correo__Usuario=seguranetarg@gmail.com
Correo__Clave=


# --- Base de datos -----------------------------------------------------------
# Fuera del directorio de la aplicación a propósito: así un despliegue que
# reemplaza los archivos del programa no se lleva por delante los datos.
ConnectionStrings__Seguranet=Data Source=/var/lib/seguranet/seguranet.db


# --- Caché -------------------------------------------------------------------
# Opcional. Vacío = caché en la memoria del proceso, que para un solo servidor
# hace lo mismo. Sólo vale la pena si algún día hay más de una instancia.
# ConnectionStrings__Redis=localhost:6379


# --- Entorno -----------------------------------------------------------------
# En Production no se publica Swagger: el contrato de la API no tiene por qué
# quedar a la vista en el sitio de cara al público.
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5080
